flowchart TB
    subgraph EXT["Dependencias externas al MVP - src/app.py"]
        SES["Sesión e inicio de sesión<br/>login, register"]
        CAT["Catálogo de productos<br/>crear, editar, eliminar"]
        LUNA["Asistente LUNA"]
    end
    subgraph MVP["MÓDULO MVP - Carrito de Compras - src/carrito/"]
        VIS["Vista del carrito<br/>templates/pedido.html, pedidos_lista.html,<br/>ordenes.html, static/js/pedido.js"]
        RUT["Rutas del carrito<br/>routes.py"]
        SRVC["Servicio de carrito<br/>carrito_service.py<br/>reglas: validar, calcular, pagar"]
        RPED["Repositorio de pedidos<br/>pedidos_repository.py"]
        RORD["Repositorio de órdenes<br/>ordenes_repository.py"]
    end
    CFG["db_config.py<br/>pool de conexiones y transacción"]
    DB[("MySQL<br/>productos, pedidos, ordenes, detalle_orden")]
    VIS -- "HTTP / fetch JSON" --> RUT
    RUT -- "usuario_id de la sesión" --> SES
    RUT --> SRVC
    SRVC --> RPED
    SRVC --> RORD
    SRVC -- "transaccion al pagar" --> CFG
    RPED --> CFG
    RORD --> CFG
    CFG --> DB
    RPED -. "lee precio y existencia" .-> CAT
